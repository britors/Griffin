{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Griffin Music",
  "version": "0.1.2",
  "identifier": "com.w3ti.griffinmusic",
  "build": {
    "beforeDevCommand": "npm run build:onnx-worker:dev && npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend && npm run build:onnx-worker",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Griffin Music",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/griffin-onnx-worker"],
    "targets": "all",
    "icon": [
      "../resources/32x32.png",
      "../resources/128x128.png",
      "../resources/256x256.png",
      "../resources/icon.ico"
    ]
  }
}
