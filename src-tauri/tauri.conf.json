{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Griffin Music",
  "version": "1.2.2",
  "identifier": "com.w3ti.griffinmusic",
  "build": {
    "beforeBuildCommand": "npm run build:frontend && npm run build:onnx-worker",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Griffin Music",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/griffin-onnx-worker"],
    "resources": ["binaries/"],
    "targets": "all",
    "icon": [
      "../resources/32x32.png",
      "../resources/128x128.png",
      "../resources/256x256.png",
      "../resources/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMDhFNkQyNjA1NDM3MTgKUldRWU4xUmcwdVlJWXo0WEV2a0U4bCtTaWFjdkxsWUk5MGJqaERsV0liTzBqRldsZS9jVWVDaUIK",
      "endpoints": [
        "https://github.com/britors/Griffin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
