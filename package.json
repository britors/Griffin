{
  "name": "griffin-music",
  "version": "0.1.2",
  "description": "Separação local de stems e prática instrumental.",
  "author": {
    "name": "W3TI",
    "email": "opensource@w3ti.com"
  },
  "homepage": "https://github.com/britors/Griffin",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:frontend": "vite build",
    "build:onnx-worker:dev": "cargo build --manifest-path src-tauri/Cargo.toml --bin griffin-onnx-worker --no-default-features",
    "build:onnx-worker": "bash scripts/build-onnx-worker.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:tauri": "bash scripts/validate-tauri.sh",
    "collect:linux": "bash scripts/collect-tauri-artifacts.sh linux",
    "collect:win": "bash scripts/collect-tauri-artifacts.sh windows",
    "validate:packages": "bash scripts/validate-packages.sh release",
    "package:linux": "bash scripts/package-tauri.sh linux",
    "package:win": "bash scripts/package-tauri.sh windows",
    "package": "tauri build"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.0",
    "@soundtouchjs/core": "^2.1.0",
    "@stemsplit/sdk": "^0.1.0",
    "audio-decode": "^3.11.4",
    "qrcode": "^1.5.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
