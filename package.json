{
  "name": "griffin-music",
  "version": "0.1.1",
  "description": "Separação local de stems e prática instrumental.",
  "desktopName": "griffin-music",
  "main": "./out/main/index.js",
  "author": {
    "name": "W3TI",
    "email": "opensource@w3ti.com"
  },
  "homepage": "https://github.com/w3ti/griffin-music",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:packages": "bash scripts/validate-packages.sh release",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.0",
    "@soundtouchjs/core": "^2.1.0",
    "@stemsplit/sdk": "^0.1.0",
    "audio-decode": "^3.11.4",
    "onnxruntime-node": "^1.22.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "com.w3ti.griffinmusic",
    "productName": "Griffin Music",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo",
      "icon": "resources",
      "maintainer": "W3TI <opensource@w3ti.com>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  }
}
